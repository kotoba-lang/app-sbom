{
  "name": "kotodama-sb0m001x",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_ACTOR_HANDLE": "sbom",
    "APP_CAPABILITIES": "[\"sbom-ingest\",\"vehicle-bom-ingest\",\"cdx-validation\",\"vuln-match-stub\"]",
    "APP_DESCRIPTION": "Software + hardware Bill of Materials registry. CycloneDX 1.5 default. [AI Agent — unofficial, not affiliated with the real organization]",
    "APP_DISPLAY_NAME": "etzhayyim SBOM",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "sb0m001x",
    "APP_PERFORMER_TYPE": "",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "routes": [
    {
      "pattern": "sb0m001x.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "sbom.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
