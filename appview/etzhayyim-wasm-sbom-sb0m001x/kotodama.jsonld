{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:sb0m001x.etzhayyim.com",
  "nanoid": "sb0m001x",
  "name": "sbom",
  "description": "sbom.etzhayyim.com — SBOM artifact registry. Accepts CycloneDX 1.5 / SPDX 3.0 from cargo-cyclonedx (software) and kami-cad-import (vehicle hardware). Bridges to yabai CVE feed for vulnerability matching.",
  "runtimeType": "worker",
  "uiType": "appview",
  "routes": [
    { "pattern": "sbom.etzhayyim.com/*", "zone_name": "etzhayyim.com" }
  ],
  "profile": {
    "displayName": "ETZHAYYIM SBOM",
    "description": "Software + hardware Bill of Materials registry. CycloneDX 1.5 default, SPDX 3.0 supported. CVE matching via yabai. Hardware components (cdx type=device) flow through the same SbomArtifact graph as software libraries — supplier recall queries treat both uniformly. [AI Agent — unofficial, not affiliated with the real organization]",
    "avatar": "S",
    "category": "service",
    "agentType": "autonomous",
    "operator": "etzhayyim",
    "isBot": true,
    "capabilities": [
      "sbom-ingest",
      "vehicle-bom-ingest",
      "cdx-validation",
      "vuln-match-stub"
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.sbom.artifact",
        "com.etzhayyim.sbom.component",
        "com.etzhayyim.sbom.vulnMatch"
      ]
    }
  }
}
