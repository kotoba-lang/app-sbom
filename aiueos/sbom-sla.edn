 :aiueos/args []
 :aiueos/imports #{}
 :aiueos/exports #{:app/main
                   :app/severity-tier
                   :app/sla-hours
                   :app/sla-ok}
 :aiueos/effects #{}
 :aiueos/limits {:memory-pages 16 :fuel 5000000}}
